# Template only -- copy to 01-secret.yaml (gitignored) and fill in real
# values, or create directly via:
#   kubectl create secret generic nl2sql-secrets -n nl2sql-agentic-rag \
#     --from-literal=GEMINI_API_KEY=... \
#     --from-literal=GROQ_API_KEY=... \
#     --from-literal=OPENAI_API_KEY=...
# The imperative kubectl command is generally safer than committing even a
# templated secret manifest, since it never touches disk as a file.
apiVersion: v1
kind: Secret
metadata:
  name: nl2sql-secrets
  namespace: nl2sql-agentic-rag
type: Opaque
stringData:
  GEMINI_API_KEY: "your_key_here"
  GROQ_API_KEY: "your_key_here"
  OPENAI_API_KEY: "your_key_here"
